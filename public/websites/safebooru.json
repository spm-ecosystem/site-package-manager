{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.12.0",
  "theme": {
    "label": "Obsidian",
    "cssVariables": {
      "--spm-bg-primary": "#000000",
      "--spm-bg-secondary": "#111111",
      "--spm-bg-tertiary": "#222222",
      "--spm-text-primary": "#ffffff",
      "--spm-text-muted": "#a1a1aa",
      "--spm-accent": "#7c6af5",
      "--spm-accent-hover": "#9d8fff",
      "--spm-accent-fg": "#ffffff",
      "--spm-border": "#333333",
      "--spm-radius": "10px"
    },
    "customStyles": ".sidebar { padding: 0 !important; background: transparent !important; }\n.sidebar h5 { font-size: 11px !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; color: var(--spm-text-muted) !important; margin: 16px 0 8px 0 !important; }\n.sidebar ul { list-style: none !important; padding: 0 !important; margin: 0 !important; display: flex !important; flex-direction: column !important; gap: 4px !important; }\n.sidebar li { font-size: 12px !important; display: flex !important; align-items: center !important; justify-content: space-between !important; }\n.sidebar li a { color: var(--spm-text-primary) !important; text-decoration: none !important; }\n.sidebar li a:hover { color: var(--spm-accent) !important; }\n.sidebar li span { color: var(--spm-text-muted) !important; }"
  },
  "components": [
    {
      "name": "UiNavHeader",
      "selector": "#header",
      "action": "replace",
      "propsMap": {
        "siteName": "#site-title a | text",
        "logoUrl": "#site-title img | attr:src"
      },
      "children": [
        {
          "name": "primaryLinks",
          "selector": "#navbar a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        },
        {
          "name": "secondaryLinks",
          "selector": "#subnavbar a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "name": "UiNavHeader",
      "selector": "#subnavbar",
      "action": "hide"
    },
    {
      "name": "UiSearchBar",
      "selector": "#tag-sidebar form, .sidebar form",
      "action": "replace",
      "propsMap": {
        "defaultValue": "input[name='tags'] | attr:value"
      },
      "props": {
        "placeholder": "Search tags…",
        "submitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "queryParamName": "tags"
      }
    }
  ],
  "reconstructs": [
    {
      "containerSelector": "#static-index",
      "layoutComponent": "UiHeroLanding",
      "propsMap": {
        "siteName": "img[alt='Safebooru'] | attr:alt",
        "logoUrl": "img[alt='Safebooru'] | attr:src"
      },
      "props": {
        "tagline": "Anime picture search engine",
        "subtext": "Browse millions of safe anime illustrations, updated hourly.",
        "ctaLabel": "Browse Gallery",
        "ctaUrl": "https://safebooru.org/index.php?page=post&s=list",
        "searchPlaceholder": "Search tags… (e.g. blue_hair 1girl)",
        "searchSubmitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "searchParamName": "tags"
      },
      "children": [
        {
          "name": "primaryLinks",
          "selector": "#links a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "propsMap": {
        "pageTitle": "h2 | text"
      },
      "props": {
        "height": "calc(100vh - 78px)"
      },
      "preserve": {
        "sidebarSlot": "div.sidebar"
      },
      "children": [
        {
          "name": "items",
          "selector": ".thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        },
        {
          "name": "pageLinks",
          "selector": ".pagination a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "#post-view",
      "layoutComponent": "UiSplitLayout",
      "propsMap": {
        "statisticsHtml": "#stats ul | html"
      },
      "props": {
        "sidebarWidth": "280px",
        "sidebarSide": "left",
        "imageFit": "contain",
        "height": "calc(100vh - 78px)",
        "showSearch": true,
        "searchPlaceholder": "Search tags…",
        "searchSubmitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "searchParamName": "tags"
      },
      "children": [
        {
          "name": "imageSlot",
          "selector": "#image",
          "propsMap": {
            "src": "self | attr:src",
            "alt": "self | attr:alt"
          }
        },
        {
          "name": "tags",
          "selector": "#tag-sidebar li.tag",
          "scope": "document",
          "propsMap": {
            "name": "a:nth-child(2) | text",
            "count": "span.tag-count | text",
            "type": "self | attr:class",
            "url": "a:nth-child(2) | attr:href"
          }
        },
        {
          "name": "buttons",
          "selector": ".link-list a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | hrefOrOnclick"
          }
        }
      ]
    }
  ]
}
