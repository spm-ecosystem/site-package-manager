{
  "manifest_version": 3,
  "name": "Site Package Manager Engine",
  "version": "1.0.1",
  "description": "Modernizes old web interfaces using React and Shadow DOM",
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content/index.iife.tsx"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/*"],
      "js": ["src/content/interceptor.iife.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    { "resources": ["devloader.html"], "matches": ["<all_urls>"] }
  ]
}
