{
  "manifest_version": 3,
  "name": "Site Package Manager Engine",
  "version": "1.1.0",
  "description": "Modernizes old web interfaces using React and Shadow DOM",
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content/index.iife.tsx"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "index.html"
  },
  "options_page": "sandbox.html",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["websites/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
