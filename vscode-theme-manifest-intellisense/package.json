{
  "name": "vscode-theme-manifest-intellisense",
  "displayName": "SPM Theme Manifest IntelliSense",
  "description": "Provides JSON schema validation and IntelliSense for Site Package Manager theme manifest files.",
  "version": "0.1.0",
  "publisher": "spm",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": [
          "**/websites/*/*/manifest.json"
        ],
        "url": "schemas/theme-manifest-schema.json"
      }
    ]
  }
}
