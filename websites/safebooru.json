{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.11.0",
  "theme": {
    "label": "Obsidian",
    "cssVariables": {
      "--spm-bg-primary": "#000000",
      "--spm-bg-secondary": "#111111",
      "--spm-bg-tertiary": "#222222",
      "--spm-text-primary": "#ffffff",
      "--spm-text-muted": "#a1a1aa",
      "--spm-accent": "#ffffff",
      "--spm-accent-hover": "#d4d4d4",
      "--spm-accent-fg": "#000000",
      "--spm-border": "#333333",
      "--spm-radius": "8px"
    },
    "customStyles": ".sidebar { padding: 0 !important; background: transparent !important; }\n.sidebar h5 { font-size: 11px !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; color: var(--spm-text-muted) !important; margin: 16px 0 8px 0 !important; }\n.sidebar ul { list-style: none !important; padding: 0 !important; margin: 0 !important; display: flex !important; flex-direction: column !important; gap: 4px !important; }\n.sidebar li { font-size: 12px !important; display: flex !important; align-items: center !important; justify-content: space-between !important; }\n.sidebar li a { color: var(--spm-text-primary) !important; text-decoration: none !important; }\n.sidebar li a:hover { color: var(--spm-accent) !important; }\n.sidebar li a[href*='page=help'] { display: none !important; }\n.sidebar li span { color: var(--spm-text-muted) !important; }"
  },
  "components": [
    {
      "name": "UiNavHeader",
      "selector": "#header",
      "action": "replace",
      "propsMap": {
        "siteName": "#site-title a | text"
      },
      "children": [
        {
          "name": "primaryLinks",
          "selector": "#navbar a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        },
        {
          "name": "secondaryLinks",
          "selector": "#subnavbar a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "name": "UiNavHeader",
      "selector": "#subnavbar",
      "action": "hide",
      "propsMap": {}
    },
    {
      "name": "UiNavHeader",
      "selector": "#tag-sidebar",
      "action": "hide",
      "propsMap": {}
    },
    {
      "name": "UiNavHeader",
      "selector": "#image-list, .related-posts",
      "action": "hide",
      "propsMap": {}
    },
    {
      "name": "UiSearchBar",
      "selector": "#tag-sidebar form, .sidebar form",
      "action": "replace",
      "propsMap": {
        "defaultValue": "input[name='tags'] | attr:value"
      },
      "props": {
        "placeholder": "Search tags…",
        "submitUrl": "https://safebooru.org/index.php?page=post&s=list"
      }
    }
  ],
  "reconstructs": [
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "propsMap": {
        "pageTitle": "h2 | text"
      },
      "preserve": {
        "sidebarSlot": "div.sidebar"
      },
      "children": [
        {
          "name": "items",
          "selector": ".thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        },
        {
          "name": "pageLinks",
          "selector": ".pagination a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "div.content:has(#image)",
      "layoutComponent": "UiPostDetails",
      "propsMap": {
        "imageUrl": "#image | attr:src",
        "statisticsHtml": "#tag-sidebar ul:last-child | html"
      },
      "props": {
        "showSearch": true,
        "searchPlaceholder": "Search tags…",
        "searchSubmitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "searchParamName": "tags"
      },
      "children": [
        {
          "name": "buttons",
          "selector": "#tag-sidebar .related-posts a, #image-list a, #related-posts a, .sidebar-list:last-child a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        },
        {
          "name": "tags",
          "selector": "#tag-sidebar li",
          "scope": "document",
          "propsMap": {
            "name": "a:nth-child(2) | text",
            "count": "span | text",
            "type": "self | attr:class",
            "url": "a:nth-child(2) | attr:href"
          }
        }
      ]
    }
  ]
}
