{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.2.0",
  "theme": {
    "cssVariables": {
      "--bg-color": "#1a1b26",
      "--text-color": "#c0caf5"
    }
  },
  "reconstructs": [
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "propsMap": {
        "pageTitle": "h2 | text"
      },
      "preserve": {
        "paginationSlot": "div.pagination",
        "sidebarSlot": "div.sidebar"
      },
      "children": [
        {
          "name": "items",
          "selector": ".thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        }
      ]
    }
  ]
}
