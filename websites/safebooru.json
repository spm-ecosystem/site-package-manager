{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.8.0",
  "theme": {
    "label": "Obsidian",
    "cssVariables": {
      "--spm-bg-primary": "#000000",
      "--spm-bg-secondary": "#111111",
      "--spm-bg-tertiary": "#222222",
      "--spm-text-primary": "#ffffff",
      "--spm-text-muted": "#a1a1aa",
      "--spm-accent": "#ffffff",
      "--spm-accent-hover": "#d4d4d4",
      "--spm-accent-fg": "#000000",
      "--spm-border": "#333333",
      "--spm-radius": "8px"
    }
  },
  "components": [
    {
      "name": "UiNavHeader",
      "selector": "#header",
      "action": "replace",
      "propsMap": {
        "siteName": "h1 | text"
      },
      "children": [
        {
          "name": "primaryLinks",
          "selector": "#navbar a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        },
        {
          "name": "secondaryLinks",
          "selector": "#subnavbar a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "name": "UiNavHeader",
      "selector": "#subnavbar",
      "action": "hide",
      "propsMap": {}
    },
    {
      "name": "UiSearchBar",
      "selector": "#tag-sidebar form, #sidebar form",
      "action": "replace",
      "propsMap": {
        "defaultValue": "input[name='tags'] | attr:value"
      },
      "props": {
        "placeholder": "Search tags…",
        "submitUrl": "https://safebooru.org/index.php?page=post&s=list"
      }
    }
  ],
  "reconstructs": [
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "propsMap": {
        "pageTitle": "h2 | text"
      },
      "preserve": {
        "sidebarSlot": "div.sidebar"
      },
      "children": [
        {
          "name": "items",
          "selector": ".thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        },
        {
          "name": "pageLinks",
          "selector": ".pagination a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "div.content:has(#image)",
      "layoutComponent": "UiPostDetails",
      "propsMap": {
        "imageUrl": "#image | attr:src",
        "statisticsHtml": "#tag-sidebar ul:last-child | html"
      },
      "children": [
        {
          "name": "actions",
          "selector": "#tag-sidebar .related-posts a, #image-list a, #related-posts a, .sidebar-list:last-child a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        },
        {
          "name": "tags",
          "selector": "#tag-sidebar li",
          "propsMap": {
            "name": "a:nth-child(2) | text",
            "count": "span | text",
            "type": "self | attr:class",
            "url": "a:nth-child(2) | attr:href"
          }
        }
      ]
    }
  ]
}
