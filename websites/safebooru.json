{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.4.0",
  "theme": {
    "label": "Obsidian",
    "cssVariables": {
      "--spm-bg-primary": "#000000",
      "--spm-bg-secondary": "#111111",
      "--spm-bg-tertiary": "#222222",
      "--spm-text-primary": "#ffffff",
      "--spm-text-muted": "#a1a1aa",
      "--spm-accent": "#ffffff",
      "--spm-accent-hover": "#d4d4d4",
      "--spm-accent-fg": "#000000",
      "--spm-border": "#333333",
      "--spm-radius": "8px"
    }
  },
  "components": [
    {
      "name": "UiSearchBar",
      "selector": ".awesomplete",
      "action": "replace",
      "propsMap": {
        "defaultValue": "input | attr:value"
      },
      "props": {
        "placeholder": "Search tags…",
        "submitUrl": "https://safebooru.org/index.php?page=post&s=list"
      }
    },
    {
      "name": "UiPaginationBar",
      "selector": "form#manualpage",
      "action": "replace",
      "propsMap": {},
      "props": {
        "baseUrl": "https://safebooru.org/index.php?page=post&s=list",
        "totalPages": 100
      }
    }
  ],
  "reconstructs": [
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "propsMap": {
        "pageTitle": "h2 | text"
      },
      "preserve": {
        "sidebarSlot": "div.sidebar"
      },
      "children": [
        {
          "name": "items",
          "selector": ".thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        }
      ]
    }
  ]
}
