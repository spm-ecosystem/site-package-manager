{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.3.0",
  "theme": {
    "label": "Obsidian",
    "cssVariables": {
      "--spm-bg-primary": "#000000",
      "--spm-bg-secondary": "#111111",
      "--spm-bg-tertiary": "#222222",
      "--spm-text-primary": "#ffffff",
      "--spm-text-muted": "#a1a1aa",
      "--spm-accent": "#ffffff",
      "--spm-accent-hover": "#d4d4d4",
      "--spm-accent-fg": "#000000",
      "--spm-border": "#333333",
      "--spm-radius": "8px"
    }
  },
  "reconstructs": [
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "propsMap": {
        "pageTitle": "h2 | text"
      },
      "preserve": {
        "paginationSlot": "div.pagination",
        "sidebarSlot": "div.sidebar"
      },
      "children": [
        {
          "name": "items",
          "selector": ".thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        }
      ]
    }
  ]
}
