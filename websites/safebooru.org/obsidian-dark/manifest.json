{
  "targetUrl": "*://safebooru.org/*",
  "version": "1.14.0",
  "theme": {
    "label": "Obsidian",
    "cssVariables": {
      "--spm-bg-primary": "#000000",
      "--spm-bg-secondary": "#111111",
      "--spm-bg-tertiary": "#222222",
      "--spm-text-primary": "#ffffff",
      "--spm-text-muted": "#a1a1aa",
      "--spm-accent": "#7c6af5",
      "--spm-accent-hover": "#9d8fff",
      "--spm-accent-fg": "#ffffff",
      "--spm-border": "#333333",
      "--spm-radius": "10px"
    },
    "customStyles": "#notice, #long-notice, #has-mail-notice, #safe-image-notice { display: none !important; }"
  },
  "components": [
    {
      "name": "UiNavHeader",
      "selector": "#header, #navbar, header, .navbar, #topbar",
      "action": "replace",
      "propsMap": {
        "siteName": "#site-title a | text",
        "logoUrl": "#site-title img | attr:src"
      },
      "props": {
        "className": "safebooru-site-nav",
        "logoHref": "https://safebooru.org/",
        "primaryLinks": [
          { "label": "My Account", "url": "https://safebooru.org/index.php?page=account&s=home" },
          { "label": "Posts", "url": "https://safebooru.org/index.php?page=post&s=list&tags=all" },
          { "label": "Comments", "url": "https://safebooru.org/index.php?page=comment&s=list" },
          { "label": "Wiki", "url": "https://safebooru.org/index.php?page=wiki&s=list" },
          { "label": "Aliases", "url": "https://safebooru.org/index.php?page=alias&s=list" },
          { "label": "Artists", "url": "https://safebooru.org/index.php?page=artist&s=list" },
          { "label": "Tags", "url": "https://safebooru.org/index.php?page=tags&s=list" },
          { "label": "Pools", "url": "https://safebooru.org/index.php?page=pool&s=list" },
          { "label": "Forum", "url": "https://safebooru.org/index.php?page=forum&s=list" },
          { "label": "Stats", "url": "https://safebooru.org/index.php?page=stats" },
          { "label": "Help", "url": "https://safebooru.org/index.php?page=help" }
        ],
        "secondaryLinks": [
          { "label": "Video", "url": "https://safebooru.org/index.php?page=post&s=list&tags=video" },
          { "label": "Upload", "url": "https://safebooru.org/index.php?page=post&s=add" },
          { "label": "My Favorites", "url": "https://safebooru.org/index.php?page=favorites&s=view" },
          { "label": "Random", "url": "https://safebooru.org/index.php?page=post&s=random" },
          { "label": "Contact Us", "url": "https://safebooru.org/index.php?page=contact" },
          { "label": "DMCA", "url": "https://safebooru.org/index.php?page=dmca" },
          { "label": "About", "url": "https://safebooru.org/index.php?page=about" },
          { "label": "Help", "url": "https://safebooru.org/index.php?page=help&topic=post" },
          { "label": "TOS", "url": "https://safebooru.org/index.php?page=tos" }
        ]
      }
    },
    {
      "name": "UiNavHeader",
      "selector": "#subnavbar",
      "action": "hide"
    },
    {
      "name": "UiSearchBar",
      "selector": "#tag-sidebar form, .tag-search form, .sidebar form",
      "action": "replace",
      "propsMap": {
        "defaultValue": "input[name='tags'] | attr:value"
      },
      "props": {
        "placeholder": "Search tags…",
        "submitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "queryParamName": "tags"
      }
    }
  ],
  "reconstructs": [
    {
      "containerSelector": "#static-index",
      "layoutComponent": "UiHeroLanding",
      "urlPattern": "safebooru\\.org\\/?(?:index\\.php)?$",
      "propsMap": {
        "siteName": "img[alt='Safebooru'] | attr:alt",
        "logoUrl": "img[alt='Safebooru'] | attr:src"
      },
      "props": {
        "tagline": "Anime picture search engine",
        "subtext": "Browse millions of safe anime illustrations, updated hourly.",
        "ctaLabel": "Browse Gallery",
        "ctaUrl": "https://safebooru.org/index.php?page=post&s=list&tags=all",
        "searchPlaceholder": "Search tags... (e.g. blue_hair 1girl)",
        "searchSubmitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "searchParamName": "tags"
      },
      "children": [
        {
          "name": "primaryLinks",
          "selector": "#links a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "#post-list",
      "layoutComponent": "UiModernGridPage",
      "urlPattern": "page=post&s=list",
      "propsMap": {
        "sidebarHtml": ".sidebar | html"
      },
      "props": {
        "className": "safebooru-gallery",
        "pageTitle": "Gallery",
        "height": "calc(100vh - 78px)",
        "sidebarWidth": "220px",
        "hideSidebarOnMobile": true,
        "mobileBreakpoint": 720,
        "mobileColumns": 2,
        "mobileGap": "8px",
        "mobilePadding": "8px",
        "mobileCardAspectRatio": "1 / 1.28",
        "mobileHeaderSticky": true,
        "mobileShowHeader": true,
        "mobileShowPagination": true
      },
      "children": [
        {
          "name": "items",
          "selector": "#post-list .thumb",
          "propsMap": {
            "imageUrl": "img | attr:src",
            "linkUrl": "a | attr:href",
            "title": "img | attr:title",
            "id": "self | attr:id"
          }
        },
        {
          "name": "pageLinks",
          "selector": "#paginator .pagination a",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "#post-view",
      "layoutComponent": "UiSplitLayout",
      "urlPattern": "page=post&s=view",
      "propsMap": {
        "statisticsHtml": "#stats ul | html"
      },
      "props": {
        "sidebarWidth": "300px",
        "sidebarSide": "left",
        "imageFit": "contain",
        "height": "calc(100vh - 78px)",
        "showSearch": true,
        "searchPlaceholder": "Search tags...",
        "searchSubmitUrl": "https://safebooru.org/index.php?page=post&s=list",
        "searchParamName": "tags"
      },
      "children": [
        {
          "name": "imageSlot",
          "selector": "#image",
          "propsMap": {
            "src": "self | attr:src",
            "alt": "self | attr:alt"
          }
        },
        {
          "name": "tags",
          "selector": "#tag-sidebar li[class*='tag-type-']",
          "scope": "document",
          "propsMap": {
            "name": "a[href*='page=post'][href*='tags='] | text",
            "count": "span.tag-count | text",
            "type": "self | attr:class",
            "url": "a[href*='page=post'][href*='tags='] | attr:href"
          }
        },
        {
          "name": "buttons",
          "selector": ".link-list a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | hrefOrOnclick",
            "targetSelector": "self | selector"
          }
        }
      ]
    },
    {
      "containerSelector": "#content:has(#comment-list)",
      "layoutComponent": "UiCommentListPage",
      "urlPattern": "page=comment&s=list",
      "props": {
        "pageTitle": "Comments",
        "height": "calc(100vh - 78px)"
      },
      "preserve": {
        "sidebarSlot": ".sidebar"
      },
      "children": [
        {
          "name": "threads",
          "selector": "#comment-list > div.post",
          "propsMap": {
            "id": "self | attr:id",
            "thumbnailUrl": ".col1 img | attr:src",
            "postUrl": ".col1 a | attr:href",
            "postDate": ".col2 span.info:nth-child(1) | text",
            "postUser": ".col2 span.info:nth-child(2) | text",
            "postRating": ".col2 span.info:nth-child(3) | text",
            "postScore": ".col2 span.info:nth-child(4) | text"
          },
          "children": [
            {
              "name": "tags",
              "selector": ".col2 .tags span",
              "propsMap": {
                "label": "a | text",
                "url": "a | attr:href",
                "type": "self | attr:class"
              }
            },
            {
              "name": "comments",
              "selector": ".response-list div.post",
              "propsMap": {
                "author": ".author h6 a | text",
                "authorUrl": ".author h6 a | attr:href",
                "date": ".author span.date | text",
                "body": ".content .body | text"
              }
            }
          ]
        },
        {
          "name": "pageLinks",
          "selector": "#paginator .pagination a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    },
    {
      "containerSelector": "#content:has(table.highlightable)",
      "layoutComponent": "UiTableListPage",
      "urlPattern": "page=wiki&s=list",
      "props": {
        "pageTitle": "Wiki Pages",
        "height": "calc(100vh - 78px)"
      },
      "preserve": {
        "sidebarSlot": ".sidebar"
      },
      "children": [
        {
          "name": "tableRows",
          "selector": "table.highlightable tr",
          "propsMap": {
            "iconUrl": "td:nth-child(1) img | attr:src",
            "iconLink": "td:nth-child(1) a | attr:href",
            "title": "td:nth-child(2) a | text",
            "titleUrl": "td:nth-child(2) a | attr:href",
            "lastUpdatedText": "td:nth-child(2) span | text",
            "lastUpdatedUser": "td:nth-child(2) span a | text",
            "lastUpdatedUserUrl": "td:nth-child(2) span a | attr:href",
            "version": "td:nth-child(3) h3 | text"
          }
        },
        {
          "name": "pageLinks",
          "selector": "#paginator .pagination a",
          "scope": "document",
          "propsMap": {
            "label": "self | text",
            "url": "self | attr:href"
          }
        }
      ]
    }
  ]
}
